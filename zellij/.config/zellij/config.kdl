// https://github.com/zellij-org/zellij/blob/main/zellij-utils/assets/config/default.kdl
theme "solarized-dark"
on_force_close "quit"
default_layout "primary"

support_kitty_keyboard_protocol true

// 0.45 defaults to a stacked-list UI (all titles listed above the expanded
// pane) and title-only frames; restore the pre-0.45 per-pane frame titles.
stacked_pane_list false
pane_frame_style "full"

// ─── Keybinds ──────────────────────────────────────────────────────────────
//
// unlock-first preset (`zellij setup --dump-keybinds unlock-first`): sessions
// start locked, so every Ctrl+<letter> but Ctrl+g reaches helix / yazi / claude.
// Ctrl+g (Cmd+i in ghostty) unlocks; then single letters enter modes
// (p pane, t tab, r resize, s scroll, o session, m move), e.g. o n jumps to
// the next pane needing attention.
//
// Live while locked: Alt+h/j/k/l and Alt+arrows (focus), Alt+n (new pane),
// Alt+f (floating), Alt+i/o (move tab), Alt+=/-/[/]/p. These shadow helix's
// Alt tree-sitter letters (Alt+o/i/n/p); the arrow forms are taken too.
//
// ghostty owns super (Cmd), Shift+arrows (adjust_selection) and Ctrl+Shift+Tab
// (previous_tab); none of those reach zellij.
//
keybinds preset="unlock-first"

// Desktop app (`zellij terminal`, the tray icon).
terminal {
    font "CommitMono Nerd Font"
    font_size 13
}
