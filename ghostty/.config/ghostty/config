# theme = Catppuccin Mocha
theme = iTerm2 Solarized Dark
# theme = TokyoNight

font-family = CommitMono Nerd Font

macos-icon = custom
maximize = true

# ─── Keybinds ──────────────────────────────────────────────────────────────
#
# Ghostty owns super (cmd) exclusively; everything else belongs to whatever is
# running inside — zellij takes Alt+arrows, Alt+<digit> and Ctrl+Alt+<letter>,
# and the TUIs (helix / yazi / claude) get every bare Ctrl+<letter> and every
# Alt+<letter>. See zellij/.config/zellij/config.kdl for the full tier map.

# Stop ghostty translating these to esc:b / esc:f locally, so they reach zellij
# as real Alt+arrow presses for pane focus. Helix keeps the equivalent motions
# on Alt+o/i/n/p, which zellij leaves alone.
macos-option-as-alt = true
keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind

# Cmd+i sends Ctrl+g (\x07) to toggle zellij's lock — Colemak-DH home row,
# so unlocking never needs a key the TUIs might want.
keybind = super+i=text:\x07

config-file = ?config.local
